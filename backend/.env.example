# GapScope Backend Environment Configuration
# Copy this file to .env and fill in your actual keys
SERPAPI_KEY=your_serpapi_key_here
YDC_API_KEY=your_youcom_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# When DEMO_MODE=1, no live network calls are made. Cache misses return None + warning.
DEMO_MODE=0

# Rate limits & budgets
SERPAPI_HOURLY_LIMIT=45
SERPAPI_SCAN_BUDGET=8

# Server configuration
PORT=5000
TRENDS_ANCHOR=credit card
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_APP_STORE=0
EXTRACT_ENGINE=extract
EXTRACT_URL_PARAM=url
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_RETRIES=3
